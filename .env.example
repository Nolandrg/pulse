# Copia este archivo como ".env" y rellena tus propios valores.
# El ".env" real NUNCA debe subirse a GitHub (ya está incluido en .gitignore).
#
# Copy this file as ".env" and fill in your own values.
# The real ".env" must NEVER be pushed to GitHub (already covered by .gitignore).

# Acceso al panel (obligatorio) / Dashboard access (required)
# Elige una contraseña larga y única. Nunca la subas a GitHub.
# Choose a long, unique password. Never commit it to GitHub.
PULSE_AUTH_USER=pulse
PULSE_AUTH_PASSWORD=

# Telegram (opcional, para notificaciones de actualizaciones)
# Telegram (optional, used for update notifications)
#
# TELEGRAM_TOKEN tiene este formato / TELEGRAM_TOKEN format:
# 123456789:ABCdefGhIJKlmNoPQRsTuVwxYZ1234567
# Lo consigues hablando con @BotFather en Telegram
# Get it by talking to @BotFather on Telegram
TELEGRAM_TOKEN=
#
# TELEGRAM_CHAT_ID es un número, por ejemplo / is a number, e.g.: 521518084
# Lo consigues hablando con @userinfobot en Telegram
# Get it by talking to @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# Zona horaria del contenedor / Container timezone
TZ=Europe/Madrid

# Intervalo de comprobación por defecto en minutos, solo se usa si aún no hay
# ninguno guardado en config/servicios.json
# Default check interval in minutes, only used if none has been saved yet
# in config/servicios.json
DEFAULT_INTERVAL=30

# Token personal de GitHub (opcional) / GitHub personal access token (optional)
# Formato / Format: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Se genera en / Generated at: GitHub > Settings > Developer settings > Personal access tokens
# Sube el límite de peticiones de 60 a 5000 por hora. También se puede
# configurar luego desde el propio panel, en Config.
# Raises the rate limit from 60 to 5000 requests/hour. Can also be set
# later from the panel itself, under Config.
GITHUB_TOKEN=
